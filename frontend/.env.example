# URL của Backend FastAPI (Local hoặc Render/Railway Production)
# Khi deploy lên Vercel/Railway, đặt giá trị: https://<ten-service>.up.railway.app/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# [CHỈ DÙNG Ở LOCAL DEV - ĐẶT TRONG FILE .env.local]
# Đặt VITE_MOCK_AUTH=true trong file .env.local nếu muốn bỏ qua màn hình đăng nhập khi test giao diện ở máy cá nhân.
# Tuyệt đối KHÔNG sửa trực tiếp useAuthStore.ts để tránh ảnh hưởng tới Production.
VITE_MOCK_AUTH=false
